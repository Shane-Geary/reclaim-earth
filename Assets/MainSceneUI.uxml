<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="BarricadeHealthBar" enabled="true" style="flex-grow: 1; width: 1%; height: 7.25%; background-size: 100% 100%; max-height: 7.5%; background-color: rgb(178, 178, 178); left: 16.5%; top: 6.5%; max-width: 1.25%;"/>
    <ui:VisualElement name="BottomControlContainer" style="flex-grow: 1; width: 20%; height: 10%; min-height: auto; max-height: 10%; flex-direction: column; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(0, 180, 255); border-right-color: rgb(0, 180, 255); border-top-color: rgb(0, 180, 255); border-bottom-color: rgb(0, 180, 255); background-color: rgba(233, 221, 221, 0.5); bottom: 5%; right: 10%; position: absolute; flex-wrap: nowrap; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px;">
        <ui:Button text="" name="PlayerControlButton" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" style="width: 20%; height: 100%; min-height: 100%; max-height: 100%; align-self: center; min-width: 20%; max-width: 20%; aspect-ratio: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; border-left-color: rgb(31, 255, 25); border-right-color: rgb(31, 255, 25); border-top-color: rgb(31, 255, 25); border-bottom-color: rgb(31, 255, 25); background-color: rgb(55, 149, 16);"/>
    </ui:VisualElement>
</ui:UXML>
